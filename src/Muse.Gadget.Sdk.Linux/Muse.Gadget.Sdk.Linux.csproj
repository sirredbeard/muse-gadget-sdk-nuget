<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Muse.Gadget.Sdk.Linux</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>.NET libraries for building Linux devices with the Muse Gadget SDK.</Description>
    <PackageTags>muse;gadget;linux;raspberry-pi;nuget</PackageTags>
    <RepositoryUrl>https://github.com/sirredbeard/muse-gadget-sdk-nuget</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
